# สร้างด้วย: npx auth secret
AUTH_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# MongoDB — ชื่อฐานข้อมูลอยู่ใน path (เช่น /velacut)
MONGODB_URI=

# อีเมลผู้ดูแล (คั่นด้วย ,) — ยืนยันยอดเติมผ่าน POST /api/admin/topups/:id/confirm
ADMIN_EMAILS=

# Cloudflare R2 — ที่เก็บไฟล์อัปโหลด (รูปโปรโมชัน)
# สร้าง API token: R2 → Manage R2 API Tokens (สิทธิ์ Object Read & Write เฉพาะ bucket นี้)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# โดเมนสาธารณะของ bucket (Custom domain หรือ https://pub-xxxx.r2.dev)
R2_PUBLIC_URL=
